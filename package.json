{
  "name": "integration-huron-person-fargate",
  "version": "0.1.0",
  "description": "This CDK TypeScript project deploys the Huron Person integration as a set of serverless ECS Fargate tasks that process batches of people synchronization in parallel",
  "bin": {
    "integration-huron-person-fargate": "bin/integration-huron-person-fargate.js"
  },
  "scripts": {
    "clearcache": "sh bin/clear-cache.sh",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "get-stack-name": "ts-node -e \"require('./src/Utils.ts').echoStackName()\"",
    "synth": "npm run get-stack-name | xargs cdk synth 2>&1 | tee cdk.out/synth.output.yaml",
    "deploy": "sh bin/deploy.sh",
    "redeploy": "cdk destroy --all -f && npm run deploy",
    "teardown": "cdk destroy -f",
    "npm-clean": "npm cache clean --force",
    "uninstall-tgz": "npm uninstall integration-huron-person",
    "install-tgz": "npm install --force integration-huron-person https://simple-npm-package-bucket.s3.us-east-1.amazonaws.com/dynamodb/integration-huron-person-1.0.0.tgz",
    "reinstall-tgz": "npm run uninstall-tgz && npm run install-tgz",
    "reinstall-tgz-clean": "npm run npm-clean && npm run uninstall-tgz && npm run install-tgz",
    "docker-build": "cd docker && sh build.sh",
    "docker-push": "cd docker && sh push.sh",
    "docker-publish": "cd docker && sh publish.sh",
    "chunker": "sh ./docker/run.sh chunker",
    "chunker-debug": "sh ./docker/run.sh --manual chunker",
    "processor": "sh ./docker/run.sh processor",
    "processor-debug": "sh ./docker/run.sh --manual processor",
    "post-processor": "sh ./docker/run.sh post-processor",
    "post-processor-debug": "sh ./docker/run.sh --manual post-processor",
    "start-full-sync": "sh bin/start-off-schedule-sync.sh --populationType person-full --bulkReset false",
    "start-full-reset": "sh bin/start-off-schedule-sync.sh --populationType person-full --bulkReset true",
    "start-delta-sync": "sh bin/start-off-schedule-sync.sh --populationType person-delta --bulkReset false",
    "start-delta-reset": "sh bin/start-off-schedule-sync.sh --populationType person-delta --bulkReset true",
    "dashboard:build:templates": "ts-node --transpile-only dashboard/scripts/BuildTemplates.ts",
    "dashboard:dev": "npm run dashboard:build:templates && ts-node dashboard/src/LocalServer.ts",
    "dashboard:dev:watch": "npm run dashboard:build:templates && nodemon --watch dashboard --exec ts-node --transpile-only dashboard/src/LocalServer.ts",
    "dashboard:synth": "npm run dashboard:build:templates && cd dashboard && cdk synth",
    "dashboard:deploy": "npm run dashboard:build:templates && cd dashboard && cdk deploy --all --no-rollback --require-approval never",
    "dashboard:teardown": "cd dashboard && cdk destroy -f",
    "dashboard:clearcache": "cd dashboard && sh bin/clear-cache.sh",
    "dashboard:publish-dev": "sh dashboard/bin/publish-to-bucket.sh"
  },
  "devDependencies": {
    "@smithy/util-stream": "^3.0.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^4.17.25",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jest": "^29.5.14",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.10.1",
    "@types/stream-json": "^1.7.8",
    "aws-cdk": "^2.1128.1",
    "aws-sdk-client-mock": "^4.0.0",
    "aws-sdk-client-mock-jest": "^4.0.0",
    "dotenv": "^17.4.1",
    "esbuild": "^0.24.2",
    "html-minifier-terser": "^7.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1156.0",
    "@aws-sdk/client-application-auto-scaling": "^3.1068.0",
    "@aws-sdk/client-cloudwatch": "^3.1079.0",
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-ecr": "^3.1012.0",
    "@aws-sdk/client-ecr-public": "^3.1013.0",
    "@aws-sdk/client-ecs": "^3.1012.0",
    "@aws-sdk/client-lambda": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1013.0",
    "@aws-sdk/client-ssm": "^3.1026.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@aws-sdk/util-dynamodb": "^3.400.0",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.0.0",
    "express": "^4.22.3",
    "integration-huron-person": "https://simple-npm-package-bucket.s3.us-east-1.amazonaws.com/dynamodb/integration-huron-person-1.0.0.tgz",
    "mustache": "^4.2.0",
    "shibboleth-sp-at-edge": "file:../../../wp_to_cloud/bu-lambda-shibboleth/shibboleth-sp-at-edge-1.0.0.tgz",
    "stream-json": "^1.8.0"
  }
}
