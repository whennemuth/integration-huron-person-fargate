<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        {{{cssAssets.dashboard}}}
    </style>
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar: a static column at lg and up, an off-canvas menu below -->
        <div class="app-sidebar">
            <aside class="offcanvas-lg offcanvas-start" id="appSidebar" tabindex="-1" aria-labelledby="appSidebarTitle">
                <div class="offcanvas-header">
                    <span class="app-brand" id="appSidebarTitle">
                        <i class="fas fa-right-left app-brand-icon"></i>Integration Dashboard
                    </span>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close navigation"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="app-brand-block d-none d-lg-block">
                        <span class="app-brand">
                            <i class="fas fa-right-left app-brand-icon"></i>Integration Dashboard
                        </span>
                        <span class="app-brand-subtitle">Boston University Person → Huron</span>
                    </div>
                    <nav class="nav flex-column app-nav" id="dashboardTabs" role="tablist" aria-orientation="vertical" aria-label="Dashboard pages">
                        {{#navigation}}
                        {{#label}}<div class="app-nav-group" role="presentation">{{label}}</div>{{/label}}
                        {{#items}}
                        <button class="nav-link {{#active}}active{{/active}}"
                                id="{{id}}-tab"
                                data-bs-toggle="pill"
                                data-bs-target="#{{id}}"
                                data-page="{{id}}"
                                type="button"
                                role="tab"
                                aria-controls="{{id}}"
                                aria-selected="{{active}}">
                            <i class="fas {{icon}} fa-fw"></i><span>{{label}}</span>
                        </button>
                        {{/items}}
                        {{/navigation}}
                    </nav>
                </div>
            </aside>
        </div>

        <div class="app-main">
            <!-- Top bar -->
            <header class="app-topbar">
                <button class="btn app-menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="app-brand d-none d-sm-inline-flex d-lg-none">Integration Dashboard</span>
                <div class="app-topbar-actions">
                    {{#landscapeBadge}}
                    <!-- This landscape, when there's no navigator to show it in -->
                    <span class="app-topbar-item landscape-badge {{#landscapeTone}}landscape-tone-{{name}}{{/landscapeTone}}" {{#landscapeTone}}title="{{description}}"{{/landscapeTone}}>
                        <i class="fas fa-layer-group" aria-hidden="true"></i>{{label}}
                        {{#landscapeTone}}<span class="visually-hidden">({{description}})</span>{{/landscapeTone}}
                    </span>
                    {{/landscapeBadge}}
                    {{#landscapeNavigator}}
                    <div class="app-topbar-item">
                        <label for="landscapeNavigator" class="app-topbar-label d-none d-md-inline">Landscape</label>
                        {{#landscapeTone}}<span class="visually-hidden" id="landscapeToneDescription">{{description}}</span>{{/landscapeTone}}
                        <select id="landscapeNavigator" class="form-select form-select-sm landscape-navigator {{#landscapeTone}}landscape-tone-{{name}}{{/landscapeTone}}" aria-label="Go to another landscape's dashboard" {{#landscapeTone}}aria-describedby="landscapeToneDescription" title="{{description}}"{{/landscapeTone}}>
                            {{#options}}
                            <option value="{{url}}" {{#selected}}selected{{/selected}} {{#disabled}}disabled{{/disabled}}>{{label}}</option>
                            {{/options}}
                        </select>
                    </div>
                    {{/landscapeNavigator}}
                    {{#signOut}}
                    {{#user}}
                    <span class="app-topbar-item app-user d-none d-sm-inline-flex">
                        <i class="fas fa-circle-user"></i>{{user}}
                    </span>
                    {{/user}}
                    <a href="{{url}}" class="btn btn-outline-secondary btn-sm text-nowrap" title="Sign out of every landscape's dashboard" aria-label="Sign out">
                        <i class="fas fa-arrow-right-from-bracket"></i><span class="d-none d-sm-inline ms-1">Sign out</span>
                    </a>
                    {{/signOut}}
                </div>
            </header>

            <!-- Pages: one tab pane each, shown by the sidebar item of the same id -->
            <main class="app-content tab-content" id="dashboardTabContent">

                {{>overview-tab}}

                {{>individual-tab}}

                {{>mapping-tab}}

                {{>bulk-tab}}

                {{>runs-tab}}

                {{>system-tab}}

            </main>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Loading, empty, error and redacted states, used by every page and component below -->
    <script>
        {{{jsAssets.pageState}}}
    </script>

    <!-- Person Card Component -->
    <script>
        {{{jsAssets.personCard}}}
    </script>
    
    <!-- Mapping Experiment Card Component -->
    <script>
        {{{jsAssets.mappingExperimentCard}}}
    </script>
    
    <!-- Run History Page -->
    <script>
        {{{jsAssets.runHistory}}}
    </script>

    <!-- Service Status Table (Status and Overview pages) -->
    <script>
        {{{jsAssets.systemStatus}}}
    </script>

    <!-- Overview Page -->
    <script>
        {{{jsAssets.overview}}}
    </script>

    <!-- Bulk Sync Page -->
    <script>
        {{{jsAssets.bulkSync}}}
    </script>

    <!-- Dashboard JavaScript -->
    <script>
        {{{jsAssets.dashboard}}}
    </script>

</body>
</html>