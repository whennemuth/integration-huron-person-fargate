<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        {{{cssAssets.dashboard}}}
    </style>
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar: a static column at lg and up, an off-canvas menu below -->
        <div class="app-sidebar">
            <aside class="offcanvas-lg offcanvas-start" id="appSidebar" tabindex="-1" aria-labelledby="appSidebarTitle">
                <div class="offcanvas-header">
                    <span class="app-brand" id="appSidebarTitle">
                        <i class="fas fa-right-left app-brand-icon"></i>Integration Dashboard
                    </span>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close navigation"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="app-brand-block d-none d-lg-block">
                        <span class="app-brand">
                            <i class="fas fa-right-left app-brand-icon"></i>Integration Dashboard
                        </span>
                        <span class="app-brand-subtitle">Boston University Person → Huron</span>
                    </div>
                    <nav class="nav flex-column app-nav" id="dashboardTabs" role="tablist" aria-orientation="vertical" aria-label="Dashboard pages">
                        {{#navigation}}
                        {{#label}}<div class="app-nav-group" role="presentation">{{label}}</div>{{/label}}
                        {{#items}}
                        <button class="nav-link {{#active}}active{{/active}}"
                                id="{{id}}-tab"
                                data-bs-toggle="pill"
                                data-bs-target="#{{id}}"
                                data-page="{{id}}"
                                type="button"
                                role="tab"
                                aria-controls="{{id}}"
                                aria-selected="{{active}}">
                            <i class="fas {{icon}} fa-fw"></i><span>{{label}}</span>
                        </button>
                        {{/items}}
                        {{/navigation}}
                    </nav>
                </div>
            </aside>
        </div>

        <div class="app-main">
            <!-- Top bar -->
            <header class="app-topbar">
                <button class="btn app-menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="app-brand d-none d-sm-inline-flex d-lg-none">Integration Dashboard</span>
                <div class="app-topbar-actions">
                    {{#landscapeBadge}}
                    <!-- This landscape, when there's no navigator to show it in -->
                    <span class="app-topbar-item landscape-badge {{#landscapeTone}}landscape-tone-{{name}}{{/landscapeTone}}" {{#landscapeTone}}title="{{description}}"{{/landscapeTone}}>
                        <i class="fas fa-layer-group" aria-hidden="true"></i>{{label}}
                        {{#landscapeTone}}<span class="visually-hidden">({{description}})</span>{{/landscapeTone}}
                    </span>
                    {{/landscapeBadge}}
                    {{#landscapeNavigator}}
                    <div class="app-topbar-item">
                        <label for="landscapeNavigator" class="app-topbar-label d-none d-md-inline">Landscape</label>
                        {{#landscapeTone}}<span class="visually-hidden" id="landscapeToneDescription">{{description}}</span>{{/landscapeTone}}
                        <select id="landscapeNavigator" class="form-select form-select-sm landscape-navigator {{#landscapeTone}}landscape-tone-{{name}}{{/landscapeTone}}" aria-label="Go to another landscape's dashboard" {{#landscapeTone}}aria-describedby="landscapeToneDescription" title="{{description}}"{{/landscapeTone}}>
                            {{#options}}
                            <option value="{{url}}" {{#selected}}selected{{/selected}} {{#disabled}}disabled{{/disabled}}>{{label}}</option>
                            {{/options}}
                        </select>
                    </div>
                    {{/landscapeNavigator}}
                    {{#impersonate}}
                    {{#start}}
                    <!-- Only for a user whose own roles allow it (decision 14): the one control hidden by role -->
                    <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#impersonateDialog" title="See the dashboard through another person's roles">
                        <i class="fas fa-user-secret"></i><span class="d-none d-sm-inline ms-1">Impersonate</span>
                    </button>
                    {{/start}}
                    {{#stop}}
                    <button type="button" class="btn btn-sm text-nowrap impersonating-stop" data-action="stop-impersonating" title="You see the dashboard through {{label}}'s roles, for viewing only">
                        <i class="fas fa-user-secret"></i><span class="ms-1">Stop impersonating {{label}}</span>
                    </button>
                    {{/stop}}
                    {{/impersonate}}
                    {{#signOut}}
                    {{#user}}
                    <!-- Who am I: the user's identity, roles, policies and actions here (WhoAmI, administration.js) -->
                    <button type="button" class="btn app-topbar-item app-user d-none d-sm-inline-flex" data-bs-toggle="modal" data-bs-target="#whoAmIDialog" title="Your roles in this landscape">
                        <i class="fas fa-circle-user"></i>{{user}}
                    </button>
                    {{/user}}
                    <a href="{{url}}" class="btn btn-outline-secondary btn-sm text-nowrap" title="Sign out of every landscape's dashboard" aria-label="Sign out">
                        <i class="fas fa-arrow-right-from-bracket"></i><span class="d-none d-sm-inline ms-1">Sign out</span>
                    </a>
                    {{/signOut}}
                </div>
            </header>

            {{#signOut}}
            <!-- A signed-in user with no role here (WhoAmI, administration.js) -->
            <div class="no-role-notice" data-no-role-notice role="status" hidden>
                <i class="fas fa-lock" aria-hidden="true"></i>
                <span>You have no role in this landscape, so the pages show no data. Ask a dashboard administrator for one.</span>
            </div>
            {{/signOut}}

            <!-- Pages: one tab pane each, shown by the sidebar item of the same id -->
            <main class="app-content tab-content" id="dashboardTabContent">

                {{>overview-tab}}

                {{>individual-tab}}

                {{>mapping-tab}}

                {{>bulk-tab}}

                {{>schedule-tab}}

                {{>runs-tab}}

                {{>system-tab}}

                {{>access-tab}}

                {{>audit-tab}}

            </main>
        </div>
    </div>

    {{#impersonate}}
    {{#start}}
    <!-- Impersonate: choose the person whose roles you see the dashboard through (ImpersonateControl, administration.js) -->
    <div class="modal fade" id="impersonateDialog" tabindex="-1" aria-labelledby="impersonateTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="impersonateTitle">See the dashboard as someone else</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="secondary">You see every page through their roles, for viewing only: anything that would change something is refused until you stop.</p>
                    <form data-impersonate-form novalidate>
                        <label for="impersonatePrincipal" class="form-label">Person</label>
                        <div class="input-group">
                            <input id="impersonatePrincipal" name="principal" class="form-control" list="impersonatePeople" placeholder="jdoe or jdoe@bu.edu" autocomplete="off" spellcheck="false">
                            <button class="btn btn-outline-secondary" type="submit">Look up</button>
                        </div>
                        <datalist id="impersonatePeople"></datalist>
                        <div class="form-text">Anyone with a role is listed; anyone else can be typed, to see what a user with no role sees.</div>
                    </form>
                    <div class="impersonate-person" data-impersonate-person></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-action="start-impersonating" disabled>
                        <i class="fas fa-user-secret me-1"></i>Impersonate
                    </button>
                </div>
            </div>
        </div>
    </div>
    {{/start}}
    {{/impersonate}}

    {{#signOut}}
    <!-- Who am I: filled from GET /api/me when opened -->
    <div class="modal fade" id="whoAmIDialog" tabindex="-1" aria-labelledby="whoAmITitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="whoAmITitle">Who you are here</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" data-who-am-i></div>
            </div>
        </div>
    </div>
    {{/signOut}}

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Loading, empty, error and redacted states, used by every page and component below -->
    <script>
        {{{jsAssets.pageState}}}
    </script>

    <!-- Person Card Component -->
    <script>
        {{{jsAssets.personCard}}}
    </script>
    
    <!-- Mapping Experiment Card Component -->
    <script>
        {{{jsAssets.mappingExperimentCard}}}
    </script>
    
    <!-- Run History Page -->
    <script>
        {{{jsAssets.runHistory}}}
    </script>

    <!-- Service Status Table (Status and Overview pages) -->
    <script>
        {{{jsAssets.systemStatus}}}
    </script>

    <!-- Overview Page -->
    <script>
        {{{jsAssets.overview}}}
    </script>

    <!-- Bulk Sync Page -->
    <script>
        {{{jsAssets.bulkSync}}}
    </script>

    <!-- Bulk Sync Schedule Page (builds on bulk-sync.js) -->
    <script>
        {{{jsAssets.bulkSchedule}}}
    </script>

    <!-- Administration: Access and Audit trail pages, and the who-am-I dialog -->
    <script>
        {{{jsAssets.administration}}}
    </script>

    <!-- Dashboard JavaScript -->
    <script>
        {{{jsAssets.dashboard}}}
    </script>

</body>
</html>