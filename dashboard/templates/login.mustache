<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        {{{cssAssets.dashboard}}}
    </style>
</head>
<body>
    <header class="app-topbar app-topbar-standalone">
        <span class="app-brand">
            <i class="fas fa-right-left app-brand-icon"></i>Integration Dashboard
        </span>
        <span class="app-brand-subtitle d-none d-sm-inline m-0">Boston University Person → Huron</span>
    </header>

    <main class="app-content">
        <div class="d-flex justify-content-center login-panel">
            <div class="card login-card">
                <div class="card-body text-center">
                    <h1 class="h5 mb-2">Sign in required</h1>
                    <p class="text-muted mb-4">
                        This dashboard requires authenticated access. Please log in to continue.
                    </p>
                    <button class="btn btn-primary" onclick="window.location.href='/login-redirect'">
                        Sign in
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>