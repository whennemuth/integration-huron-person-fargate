<!-- Status page -->
<div class="tab-pane fade {{#systemActive}}show active{{/systemActive}}" id="system" role="tabpanel" aria-labelledby="system-tab">
    <div class="page">
        <header class="page-header">
            <div>
                <h1 class="page-title">Status</h1>
                <p class="page-description">Health of the services the integration depends on, and recent sync figures.</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-sm btn-outline-secondary" type="button" onclick="loadSystemStatus()">
                    <i class="fas fa-rotate-right me-1"></i>Refresh
                </button>
            </div>
        </header>

        <!-- Both sections are filled by loadSystemStatus() (dashboard.js) when the page is shown -->
        <section class="page-section" aria-label="Sync figures">
            <div id="systemMetrics"></div>
        </section>

        <section class="page-section" aria-labelledby="serviceStatusHeading">
            <div class="section-heading">
                <h2 class="section-title" id="serviceStatusHeading">Services</h2>
            </div>
            <div class="surface surface-flush" id="serviceStatus"></div>
        </section>
    </div>
</div>
