<!-- Audit trail page: who did what in this landscape (authorization-plan.md, decision 9) -->
<div class="tab-pane fade {{#auditActive}}show active{{/auditActive}}" id="audit" role="tabpanel" aria-labelledby="audit-tab">
    <div class="page">
        <header class="page-header">
            <div>
                <h1 class="page-title">Audit trail</h1>
                <p class="page-description">Who looked up or synced people, started runs, changed roles or was refused, newest first.</p>
            </div>
            <div class="page-actions">
                <span class="refresh-stamp" data-refresh-stamp="audit"></span>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-action="refresh-audit">
                    <i class="fas fa-rotate-right me-1"></i>Refresh
                </button>
            </div>
        </header>

        <section class="page-section" aria-label="Filters">
            <form class="audit-filters" data-audit-filters novalidate>
                <div>
                    <label for="auditPrincipal" class="form-label">Person</label>
                    <input id="auditPrincipal" name="principal" class="form-control form-control-sm" placeholder="Anyone" autocomplete="off" spellcheck="false">
                </div>
                <div>
                    <label for="auditAction" class="form-label">Action</label>
                    <select id="auditAction" name="action" class="form-select form-select-sm">
                        <option value="">Any action</option>
                        {{#auditActions}}
                        <option value="{{.}}">{{.}}</option>
                        {{/auditActions}}
                    </select>
                </div>
                <div class="audit-filters-actions">
                    <button class="btn btn-sm btn-primary" type="submit">Apply</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-action="clear-audit-filters">Clear</button>
                </div>
            </form>
        </section>

        <section class="page-section" aria-label="Audit records">
            <!-- Filled by AuditTrailPage (administration.js) when the page is shown -->
            <div class="surface surface-flush" data-audit-list></div>
        </section>
    </div>
</div>
