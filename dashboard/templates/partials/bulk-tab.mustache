<!-- Bulk sync page: start a sync run in this landscape, as its schedule does (public/js/bulk-sync.js fills it) -->
<div class="tab-pane fade {{#bulkActive}}show active{{/bulkActive}}" id="bulk" role="tabpanel" aria-labelledby="bulk-tab">
    <div class="page">
        <header class="page-header">
            <div>
                <h1 class="page-title">Bulk sync</h1>
                <p class="page-description">Start a sync run in this landscape, the way its schedule starts one.</p>
            </div>
            <div class="page-actions">
                <span class="refresh-stamp" data-refresh-stamp="bulk"></span>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-action="refresh-bulk">
                    <i class="fas fa-rotate-right me-1"></i>Refresh
                </button>
            </div>
        </header>

        <div class="page-columns">
            <section class="page-section" aria-labelledby="bulkSyncHeading">
                <div class="section-heading">
                    <h2 class="section-title" id="bulkSyncHeading">New run</h2>
                </div>
                <div class="surface" data-bulk-form></div>
            </section>

            <section class="page-section" aria-labelledby="bulkStatusHeading">
                <div class="section-heading">
                    <h2 class="section-title" id="bulkStatusHeading">Status</h2>
                </div>
                <div class="surface" data-bulk-status></div>
            </section>
        </div>
    </div>
</div>
