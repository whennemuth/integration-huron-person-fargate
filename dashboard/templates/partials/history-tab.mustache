<!-- Activity history page -->
<div class="tab-pane fade {{#historyActive}}show active{{/historyActive}}" id="history" role="tabpanel" aria-labelledby="history-tab">
    <div class="page">
        <header class="page-header">
            <div>
                <h1 class="page-title">Activity history</h1>
                <p class="page-description">Recent syncs in this landscape, newest first.</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-sm btn-outline-secondary" type="button" onclick="refreshHistory()">
                    <i class="fas fa-rotate-right me-1"></i>Refresh
                </button>
            </div>
        </header>

        <section class="page-section" aria-label="Activity history">
            <!-- Filled by loadHistory() (dashboard.js) when the page is shown -->
            <div class="surface surface-flush" id="historyContent"></div>
        </section>
    </div>
</div>
