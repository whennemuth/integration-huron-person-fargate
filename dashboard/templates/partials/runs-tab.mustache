<!-- Run history page: the list of runs (#runs), or one run's page (#runs/<syncRunId>) -->
<div class="tab-pane fade {{#runsActive}}show active{{/runsActive}}" id="runs" role="tabpanel" aria-labelledby="runs-tab">
    <div class="page">
        <div data-view="list">
            <header class="page-header">
                <div>
                    <h1 class="page-title">Run history</h1>
                    <p class="page-description">Sync runs in this landscape, newest first. Choose a run to see its chunks, errors and changes.</p>
                </div>
                <div class="page-actions">
                    <span class="refresh-stamp" data-refresh-stamp="runs"></span>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-action="refresh-runs">
                        <i class="fas fa-rotate-right me-1"></i>Refresh
                    </button>
                </div>
            </header>

            <section class="page-section" aria-label="Runs">
                <!-- Filled by RunHistoryPage (run-history.js) when the page is shown -->
                <div class="surface surface-flush" data-run-list></div>
            </section>
        </div>

        <!-- Filled by RunDetailView (run-history.js) when a run is opened -->
        <div data-view="detail" hidden></div>
    </div>
</div>
