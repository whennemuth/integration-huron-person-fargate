<!-- Mapping experiment page -->
<div class="tab-pane fade {{#mappingActive}}show active{{/mappingActive}}"
     id="mapping"
     role="tabpanel"
     aria-labelledby="mapping-tab">
    <div class="page">
        <header class="page-header">
            <div>
                <h1 class="page-title">Mapping experiment</h1>
                <p class="page-description">Paste a person record as the Boston University person API returns it and see how it maps to Huron. Nothing is looked up, and nothing is sent to Huron.</p>
            </div>
        </header>

        <section class="page-section" aria-label="Mapping experiment">
            <div class="surface">
                <div id="mappingExperimentContainer"></div>
            </div>
        </section>
    </div>
</div>
