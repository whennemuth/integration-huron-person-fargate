# The local dashboard server's settings: copy this file to LocalLaunch.env (git-ignored) beside it.
# `npm run dashboard:dev` reads only LocalLaunch.env, never the repository's .env.
#
# Without mocks, the launcher looks up the landscape's deployed dashboard Lambda at every launch and runs the
# server with that Lambda's environment (its secrets left out), so nothing of the landscape is kept here.
# To see what it looks up: DASHBOARD_LAMBDA_FUNCTION_TASK=show npx ts-node -r dotenv/config dashboard/scripts/LambdaFunction.ts

# ---------- The landscape ---------- #
# Whose dashboard Lambda to run as (its function is <STACK_ID>-<LANDSCAPE>-app-function in REGION)
LANDSCAPE=<landscape, e.g. preview>
REGION=<aws-region, e.g. us-east-2>
# STACK_ID=hp-dashboard
# The AWS credentials the local server uses in place of the Lambda's role (not needed with MOCKED=true)
AWS_PROFILE=<aws-profile>

# ---------- Switches ---------- #
# true: the mock services, with made-up landscapes and runs, and no AWS access (no Lambda lookup)
MOCKED=false
# none: public mode, no sign-in | mock: signed in as USER_PRINCIPAL, without an IdP
AUTHENTICATION=mock
# true: restart the server when a file under dashboard/ changes (the Lambda is looked up once, not per restart)
WATCH=false
# With MOCKED=true, the storage mode the mock run reporting reports: dynamodb | s3
MOCK_STORAGE_MODE=dynamodb
# PORT=3000
# Without mocks the launcher refuses a landscape whose LANDSCAPE_TONE is production, unless this is true
# ALLOW_PRODUCTION=false

# ---------- The mock signed-in user (AUTHENTICATION=mock) ---------- #
# The buPrincipal claim, required, and optional profile claims
USER_PRINCIPAL=<buPrincipal, e.g. jdoe>
# USER_EPPN=<eduPersonPrincipalName, e.g. jdoe@bu.edu>
# USER_MAIL=<mail>
# USER_GIVEN_NAME=<given name>
# USER_SURNAME=<surname>

# ---------- Overrides ---------- #
# A variable set here wins over the Lambda's value (the launcher logs each override), e.g. to try a top bar tint.
# Without a deployed dashboard Lambda, the whole Lambda environment can be given here by hand instead.
# LANDSCAPE_TONE=test
