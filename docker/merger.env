# AWS and environment parameters.
AWS_PROFILE=infnprd
REGION=us-east-2
NODE_ENV=production

# Configuration loading (priority order: HURON_PERSON_CONFIG_JSON > SECRET_ARN > HURON_PERSON_CONFIG_PATH)
# HURON_PERSON_CONFIG_JSON='{"dataSource":...,"dataTarget":...,"storage":{"type":"s3","config":{...}}}'
SECRET_ARN=arn:aws:secretsmanager:us-east-2:770203350335:secret:huron-person-fargate-processor/integration/_config/dev-xug4Og

# Name of the S3 bucket containing the original large input JSON file with person records.
INPUT_BUCKET=huron-person-file-drop-dev

# Name of the bucket for chunk files - ndjson files with primary key and person delta hashes - 
# output by the processor service.
CHUNKS_BUCKET=huron-person-chunks-dev

PREVIOUS_STORAGE_TYPE=s3

# Shared delta storage directory (for baseline previous-input.ndjson and hashes.ndjson files)
SHARED_DELTA_STORAGE_DIR=delta-storage

# DynamoDB Tables (required for statistics tracking in both S3 and DynamoDB modes)
DYNAMODB_STATISTICS_TABLE_NAME=huron-person-fargate-statistics-dev

# Person deletion handling strategy
PERSON_DELETE_TYPE=deferred

# ECS Task Protection (for testing scale-in protection locally)
# ECS_AGENT_URI is auto-provided in ECS Fargate, uncomment for local testing
# ECS_AGENT_URI=http://169.254.170.2/api

# Cache configuration (for PersonCache testing)
CACHE_ENABLED=true
# CACHE_PATH=/tmp/cache

# ECS task context flag (auto-set by ECS, can override for local testing)
IS_ECS_TASK=false

# Dryrun mode (set to true to avoid actual creates/puts/patches to the target API)
DRY_RUN=true