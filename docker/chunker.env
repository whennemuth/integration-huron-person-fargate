# AWS and environment parameters.
AWS_PROFILE=infnprd
REGION=us-east-2
NODE_ENV=production

# Source fetch type: 's3' or 'api'
# - 's3': Read from S3 bucket (uses INPUT_BUCKET and INPUT_KEY)
# - 'api': Fetch from API endpoint (uses config from HURON_PERSON_CONFIG_JSON/SECRET_ARN and SYNC_TYPE)
SOURCE_FETCH_TYPE=api

# S3 mode: Details of the original large input json file with person records.
INPUT_BUCKET=huron-person-file-drop-dev
INPUT_KEY=person-full/2026-03-03T19:58:41.277Z-people.json

# API mode: Configuration and sync type
# Config loaded via same pattern as processor.ts:
# - HURON_PERSON_CONFIG_JSON (from TaskDef secrets in Fargate)
# - SECRET_ARN (fallback to Secrets Manager)
# - HURON_PERSON_CONFIG_PATH (local staging only, e.g., ../integration-huron-person/config/config.staging.json)
# SYNC_TYPE=person-full

SECRET_ARN=arn:aws:secretsmanager:us-east-2:770203350335:secret:huron-person-fargate-chunker/integration/_config/dev-xug4Og

# Name of the S3 bucket for chunk files - ndjson files with subsets of person records -
# output by the chunker service.
CHUNKS_BUCKET=huron-person-chunks-staging
SHARED_DELTA_STORAGE_DIR=delta-storage

# Chunking configuration
ITEMS_PER_CHUNK=200
PERSON_ID_FIELD=personid

# DynamoDB Atomic Counter Table (used for generating unique chunk IDs and offsets)
DYNAMODB_ATOMIC_COUNTER_TABLE_NAME=huron-person-fargate-atomic-counter-dev

# ECS Infrastructure (for service scaling and task coordination)
STACK_ID=huron-person-fargate
LANDSCAPE=dev
ECS_CLUSTER_NAME=huron-person-fargate-cluster-dev
ECS_SERVICE_NAME=huron-person-fargate-chunker-service-dev
MAX_SCALING_CAPACITY=10

# SQS Queue for task parameters (ECS Fargate mode)
# SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/770203350335/huron-person-chunker-queue-dev

# ECS Task Protection (for testing scale-in protection locally)
# ECS_AGENT_URI is auto-provided in ECS Fargate, uncomment for local testing
# ECS_AGENT_URI=http://169.254.170.2/api

# Cache configuration (for PersonCache testing)
CACHE_ENABLED=true
# CACHE_PATH=/tmp/cache

# Testing modes (for local development and debugging)
# POPULATION_SCOPE - Limit chunking to specific population subset
# POPULATION_TYPE - Override sync population type (person-full or person-delta)
# CHUNK_DIRECTORY - Explicit chunk directory path (bypasses normal path derivation)
# SINGLE_PERSON_BUID - Test with single person by BUID
# POPULATION_SCOPE=test-population
# POPULATION_TYPE=person-full
# CHUNK_DIRECTORY=chunks/person-full/2026-03-03T19:58:41.277Z
# SINGLE_PERSON_BUID=U12345678

# API Retry Strategy (optional - JSON string from ECS context)
# RETRY_STRATEGY={"retryStrategyType":"exponential","retryStrategyOptions":{"maxRetries":3,"baseDelay":1000}}

# Bulk reset flag (force target system lookups for create vs patch determination)
# BULK_RESET=false

# Trust previous storage flag (skip validation of baseline delta files)
# TRUST_PREVIOUS_STORAGE=true

# ECS task context flag (auto-set by ECS, can override for local testing)
IS_ECS_TASK=false

# Pause before early exit (gives time to review logs before container stops)
# PAUSE_BEFORE_EARLY_EXIT=true

# Dry run mode for testing - set to true to avoid actual writes to S3 and just log actions instead.
DRY_RUN=true